{
  "safety": {
    "mode": "dry_run",
    "audit": false,
    "min_file_age_hours": 24,
    "stability_check_seconds": 2.0,
    "max_size_ratio": 5.0,
    "quarantine_dir": "/mnt/user/Temp/izumi_quarantine",
    "retention_days": 7,
    "auto_purge": false
  },
  "logging": { "level": "INFO", "dir": "/mnt/cache/appdata/izumi/logs", "rotate_mb": 10, "backups": 5 },
  "reporting": { "dir": "/mnt/cache/appdata/izumi/reports", "metrics": true },
  "notify": {
    "enabled": false,
    "level": "fail",
    "provider": "telegram",
    "token_ref": "IZUMI_TELEGRAM_BOT_TOKEN",
    "chat_id_ref": "IZUMI_TELEGRAM_CHAT_ID"
  },
  "paths": {
    "media_root": "/mnt/user/media",
    "movies_root": "/mnt/user/media/Peliculas",
    "series_root": "/mnt/user/media/series TV",
    "downloads_root": "/mnt/user/Downloads",
    "organizer_source": "/mnt/cache/Downloads/DF/Manuales",
    "extract_source": "/mnt/cache/Downloads/DF/Manuales"
  },
  "pipelines": {
    "monitor": ["downloads_watchdog", "disk_inventory"],
    "inventory": ["docker_inventory", "disk_inventory", "share_inventory", "network_inventory", "dashboard"],
    "daily": ["media_integrity", "arr_orphans", "dashboard"],
    "weekly": ["plex_dupefinder"]
  },
  "integrations": {
    "radarr": { "url": "http://192.168.6.62:7878", "api_key_ref": "RADARR_API_KEY" },
    "sonarr": { "url": "http://192.168.6.62:8989", "api_key_ref": "SONARR_API_KEY" },
    "qbittorrent": {
      "url": "http://192.168.6.62:8080",
      "username_ref": "QBIT_USERNAME",
      "password_ref": "QBIT_PASSWORD",
      "stalled_hours": 48
    },
    "tmdb": { "bearer_ref": "TMDB_BEARER_TOKEN" },
    "ai": { "providers": ["ollama", "gemini"], "escalate_below": 80 },
    "ollama": { "base_url": "http://192.168.6.62:11434", "model": "qwen3:8b" },
    "gemini": {
      "api_key_ref": "GEMINI_API_KEY",
      "model": "gemini-2.0-flash",
      "confidence_threshold": 80,
      "apply": false,
      "ai_fallback": true
    },
    "logwatch": {
      "days": 7,
      "containers": [],
      "max_error_lines": 400,
      "max_lines_per_container": 60,
      "max_log_lines": 20000,
      "num_ctx": 8192
    },
    "analyst": {
      "max_items": 100,
      "dupefinder_reports": "/mnt/cache/Downloads/DF/REPORTS",
      "num_ctx": 8192
    },
    "uptime": {
      "targets": [
        { "name": "Plex", "host": "192.168.x.x", "port": 32400 },
        { "name": "Sonarr", "host": "192.168.x.x", "port": 8989 },
        { "name": "Radarr", "host": "192.168.x.x", "port": 7878 }
      ],
      "expect_running": [],
      "ignore_containers": ["Configarr", "recyclarr", "watchtower"],
      "timeout": 3.0
    },
    "diskwatch": {
      "disks": [],
      "temp_warn": 50
    },
    "dbcheck": {
      "databases": [
        { "name": "sonarr", "path": "/mnt/cache/appdata/sonarr/sonarr.db" },
        { "name": "radarr", "path": "/mnt/cache/appdata/radarr/radarr.db" }
      ]
    },
    "dbrepair": {
      "verify_timeout_s": 30,
      "repair_strategy_order": ["native_backup", "recover"],
      "databases": [
        {
          "app": "sonarr",
          "container": "sonarr",
          "db_path": "/mnt/cache/appdata/sonarr/sonarr.db",
          "native_backup_glob": "/mnt/cache/appdata/sonarr/Backups/scheduled/*.zip"
        },
        {
          "app": "radarr",
          "container": "radarr",
          "db_path": "/mnt/cache/appdata/radarr/radarr.db",
          "native_backup_glob": "/mnt/cache/appdata/radarr/Backups/scheduled/*.zip"
        }
      ]
    },
    "status": {
      "ignore_containers": ["Configarr", "recyclarr", "watchtower"]
    },
    "autoheal": {
      "ignore_containers": ["Configarr", "recyclarr", "watchtower"]
    },
    "plexrefresh": {
      "paths": [],
      "sections": [],
      "media_extensions": [".mkv", ".mp4", ".avi"],
      "dupefinder_reports": "/mnt/cache/Downloads/DF/REPORTS"
    },
    "notifypush": {
      "title": "izumi · informe",
      "max_section_chars": 1200,
      "sources": ["uptime", "diskwatch", "dbcheck", "status", "autoheal", "analyst", "logwatch"]
    }
  }
}
