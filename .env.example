# izumi secrets — copy to `.env` (git-ignored) and fill in. NEVER commit `.env`.
# Loaded by core/secrets.py (env vars take precedence over this file).
# Rotate any value that ever lived in the legacy scripts (see SECURITY.md).

# --- Plex ---
PLEX_TOKEN=

# --- Radarr / Sonarr ---
RADARR_URL=http://192.168.x.x:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.x.x:8989
SONARR_API_KEY=

# --- qBittorrent ---
QBIT_URL=http://192.168.x.x:8080
QBIT_USERNAME=
QBIT_PASSWORD=

# --- TMDb / TVmaze ---
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# --- Google Gemini (media title identification, organizer module) ---
GEMINI_API_KEY=

# --- Telegram (single notifier + operations bot: `python3 bot.py`) ---
# BOT_TOKEN: from @BotFather. CHAT_ID: your numeric id (talk to @userinfobot).
# Only chats in the allow-list (CHAT_ID + optional comma-separated ALLOWED_IDS)
# may drive the bot; everyone else is ignored.
IZUMI_TELEGRAM_BOT_TOKEN=
IZUMI_TELEGRAM_CHAT_ID=
IZUMI_TELEGRAM_ALLOWED_IDS=
IZUMI_TELEGRAM_THREAD_ID=

# --- Discord (optional 2nd alert channel: Server Settings > Integrations > Webhooks) ---
# When set (and referenced by integrations.notifypush.discord_webhook_ref), the
# nightly digest is also posted to this webhook. Send-only; keep it secret.
IZUMI_DISCORD_WEBHOOK=

# --- Sentinel (external watchdog: `python sentinel.py` on a secondary always-on PC) ---
# Runs OFF the server (same LAN) so it can warn you even when the server/bot is down.
# Reuses the Telegram token above (send-only, no conflict with the bot). SERVER is the
# master check (host:port, default port 443); TARGETS are the services to watch.
IZUMI_SENTINEL_SERVER=192.168.x.x:443
IZUMI_SENTINEL_TARGETS=plex=192.168.x.x:32400,sonarr=192.168.x.x:8989,radarr=192.168.x.x:7878,overseerr=https://overseerr.example.com
IZUMI_SENTINEL_INTERVAL=60
IZUMI_SENTINEL_FAILS=3
IZUMI_SENTINEL_TIMEOUT=8
