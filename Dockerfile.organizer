# Image for the izumi organizer/health when launched from the menu.
# python:3.12 (the platform needs 3.11+) + ffmpeg so ffprobe can read media
# metadata (duration / embedded tags / audio languages) to help identification.
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
